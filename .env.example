DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway
S3_ENDPOINT=https://YOUR_PRIVATE_S3_ENDPOINT
S3_BUCKET=dialogue-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=10485760
NODE_ENV=production
ADMIN_BOOTSTRAP_EMAIL=admin@dialoguenational.cd
ADMIN_BOOTSTRAP_PASSWORD=change-this-long-password
ADMIN_SESSION_HOURS=12
